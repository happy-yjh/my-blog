---
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">首页</HeaderLink>
			<HeaderLink href="/blog">博客</HeaderLink>
			<HeaderLink href="/nav">网站推荐</HeaderLink>
			<HeaderLink href="/tools">小工具</HeaderLink>
			<HeaderLink href="/about">关于</HeaderLink>
		</div>
		<div class="actions">
			<ThemeToggle />
			<a href="https://github.com/happy-yjh" target="_blank" rel="noopener noreferrer" class="github-link">
				<span class="sr-only">GitHub</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="24" height="24" fill="currentColor">
					<path
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path>
				</svg>
			</a>
		</div>
	</nav>
</header>

<style>
	header {
		margin: 0;
		padding: 0 1.5em;
		background: var(--header-bg);
		border-bottom: 1px solid var(--card-border);
		transition: background-color 0.25s ease, border-color 0.25s ease;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 960px;
		margin: 0 auto;
		height: 64px;
	}
	h2 {
		margin: 0;
		font-size: 1.1rem;
	}
	h2 a {
		text-decoration: none;
		color: var(--heading-color);
	}
	.internal-links {
		display: flex;
		gap: 0.5rem;
	}
	.internal-links a {
		padding: 0.5em 0.8em;
		color: var(--text-color);
		border-bottom: 3px solid transparent;
		text-decoration: none;
		font-weight: 500;
	}
	.internal-links a.active {
		border-bottom-color: var(--accent);
		color: var(--accent);
	}
	.actions {
		display: flex;
		align-items: center;
		gap: 12px;
	}
	.github-link {
		color: var(--text-color);
		display: flex;
		align-items: center;
		text-decoration: none;
	}
	.github-link:hover {
		color: var(--accent);
	}
</style>