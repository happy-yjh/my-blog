---
import HeaderLink from './HeaderLink.astro';
import ThemeToggle from './ThemeToggle.astro';
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<div class="nav-top">
			<h2><a href="/">{SITE_TITLE}</a></h2>
			<div class="action-buttons">
				<ThemeToggle />
				<a href="https://github.com/happy-yjh" target="_blank" rel="noopener noreferrer" class="github-link" aria-label="GitHub">
					<svg viewBox="0 0 16 16" aria-hidden="true" width="20" height="20">
						<path
							fill="currentColor"
							d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
						></path>
					</svg>
				</a>
			</div>
		</div>

		<div class="internal-links">
			<HeaderLink href="/">首页</HeaderLink>
			<HeaderLink href="/blog">博客</HeaderLink>
			<HeaderLink href="/links">网站推荐</HeaderLink>
			<HeaderLink href="/tools">小工具</HeaderLink>
			<HeaderLink href="/steam">游戏 / Steam</HeaderLink>
		</div>
	</nav>
</header>

<style>
	header {
		margin: 0;
		padding: 0 1.5rem;
		background: rgba(11, 15, 23, 0.85);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
		position: sticky;
		top: 0;
		z-index: 100;
	}

	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 960px;
		margin: 0 auto;
		height: 64px;
	}

	.nav-top {
		display: flex;
		align-items: center;
		gap: 1rem;
	}

	h2 {
		margin: 0;
		font-size: 1.15rem;
		font-weight: 700;
		white-space: nowrap;
	}

	h2 a {
		text-decoration: none;
		color: #ffffff;
		letter-spacing: -0.01em;
	}

	.internal-links {
		display: flex;
		align-items: center;
		gap: 1.25rem;
	}

	.internal-links a {
		padding: 0.5rem 0.2rem;
		color: #94a3b8;
		text-decoration: none;
		font-size: 0.95rem;
		font-weight: 500;
		white-space: nowrap;
		border-bottom: 2px solid transparent;
		transition: all 0.2s ease;
	}

	.internal-links a:hover,
	.internal-links a.active {
		color: #38bdf8;
		border-bottom-color: #38bdf8;
	}

	.action-buttons {
		display: flex;
		align-items: center;
		gap: 0.75rem;
	}

	.github-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		color: #94a3b8;
		text-decoration: none;
		transition: color 0.2s ease;
	}

	.github-link:hover {
		color: #ffffff;
	}

	/* 📱 手机端响应式适配 (屏幕宽度小于 768px 时生效) */
	@media (max-width: 768px) {
		header {
			padding: 0.6rem 1rem;
		}

		nav {
			flex-direction: column;
			align-items: stretch;
			height: auto;
			gap: 0.5rem;
		}

		.nav-top {
			justify-content: space-between;
			width: 100%;
		}

		h2 {
			font-size: 1.05rem;
		}

		/* 导航栏单行支持横向平滑手势滑动，文字不折行、不重叠 */
		.internal-links {
			display: flex;
			gap: 1.25rem;
			overflow-x: auto;
			white-space: nowrap;
			-webkit-overflow-scrolling: touch;
			padding-bottom: 4px;
			scrollbar-width: none;
		}

		.internal-links::-webkit-scrollbar {
			display: none;
		}

		.internal-links a {
			font-size: 0.9rem;
			padding: 0.25rem 0;
			flex-shrink: 0;
		}
	}
</style>