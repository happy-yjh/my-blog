---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE } from '../consts';

// 已绑定你正确的豆瓣个人 ID
const DOUBAN_USER_ID = '204088971'; 

interface DoubanItem {
	title: string;
	link: string;
	pubDate: string;
	rating: string;
	comment: string;
	imgSrc: string;
}

let items: DoubanItem[] = [];

try {
	const rssUrl = `https://www.douban.com/feed/people/${DOUBAN_USER_ID}/interests`;
	const res = await fetch(rssUrl, {
		headers: {
			'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36'
		}
	});

	if (res.ok) {
		const xmlText = await res.text();
		const itemBlocks = xmlText.split('<item>').slice(1);

		for (const block of itemBlocks) {
			const itemContent = block.split('</item>')[0];

			// 提取标题并剔除 CDATA
			const rawTitle = (itemContent.match(/<title>([\s\S]*?)<\/title>/)?.[1] || '')
				.replace(/<!\[CDATA\[\vert{}\]\]>/g, '')
				.trim();

			// 提取条目链接
			const link = (itemContent.match(/<link>([\s\S]*?)<\/link>/)?.[1] || '')
				.replace(/<!\[CDATA\[\vert{}\]\]>/g, '')
				.trim();

			// 提取标记日期
			const rawDate = itemContent.match(/<pubDate>([\s\S]*?)<\/pubDate>/)?.[1] || '';
			const pubDate = rawDate ? new Date(rawDate).toLocaleDateString('zh-CN') : '';

			// 提取描述内容
			const rawDesc = itemContent.match(/<description>([\s\S]*?)<\/description>/)?.[1] || '';

			// 提取海报并经由公共代理规避防盗链
			let imgSrc = '';
			const imgMatch = rawDesc.match(/src=["'](https?:\/\/[^"']+)["']/i);
			if (imgMatch) {
				let originalImg = imgMatch[1];
				originalImg = originalImg.replace(/s_ratio_poster|sposter/, 'l_ratio_poster');
				imgSrc = `https://images.weserv.nl/?url=${encodeURIComponent(originalImg)}`;
			}

			// 提取星级评分
			let rating = '';
			const ratingMatch = rawDesc.match(/推荐:\s*([^\s<\]]+)/);
			if (ratingMatch) {
				rating = ratingMatch[1];
			}

			// 清理短评
			let comment = rawDesc
				.replace(/<[^>]+>/g, ' ')
				.replace(/<!\[CDATA\[\vert{}\]\]>/g, '')
				.replace(/推荐:\s*[^\s]+/g, '')
				.replace(/&nbsp;/g, ' ')
				.replace(/\s+/g, ' ')
				.trim();

			if (rawTitle) {
				items.push({
					title: rawTitle,
					link,
					pubDate,
					rating,
					comment,
					imgSrc
				});
			}
		}
	}
} catch (e) {
	console.error('抓取豆瓣数据失败:', e);
}
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`豆瓣书影音 - ${SITE_TITLE}`} description="记录我的电影、图书与生活足迹" />
		<meta name="referrer" content="no-referrer" />
		<style>
			main {
				max-width: 960px;
				margin: 1.5rem auto 4rem;
				padding: 0 1rem;
				box-sizing: border-box;
			}
			.page-header {
				margin-bottom: 2rem;
			}
			.page-title {
				font-size: 1.75rem;
				font-weight: 800;
				margin: 0 0 0.4rem 0;
				display: flex;
				align-items: center;
				gap: 8px;
			}
			.page-desc {
				color: #64748b;
				margin: 0 0 8px 0;
				font-size: 0.95rem;
			}
			.page-meta {
				font-size: 0.8rem;
				color: #94a3b8;
			}
			.page-meta a {
				color: #0284c7;
				text-decoration: none;
			}
			:global(html.dark) .page-meta a {
				color: #38bdf8;
			}

			/* 豆瓣卡片自适应网格 */
			.douban-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
				gap: 16px;
			}
			.douban-card {
				display: flex;
				background: #ffffff;
				border: 1px solid rgba(0, 0, 0, 0.08);
				border-radius: 12px;
				overflow: hidden;
				text-decoration: none;
				color: inherit;
				box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
				transition: all 0.2s ease;
			}
			.douban-card:hover {
				transform: translateY(-3px);
				border-color: #0284c7;
				box-shadow: 0 6px 16px rgba(2, 132, 199, 0.12);
			}
			:global(html.dark) .douban-card {
				background: rgba(22, 27, 34, 0.65);
				border-color: rgba(255, 255, 255, 0.08);
				box-shadow: none;
			}
			:global(html.dark) .douban-card:hover {
				border-color: rgba(56, 189, 248, 0.4);
				background: rgba(22, 27, 34, 0.9);
			}

			.cover-wrap {
				width: 105px;
				min-height: 145px;
				flex-shrink: 0;
				background: #1e293b;
				position: relative;
				overflow: hidden;
			}
			.douban-cover {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
			}

			.info-wrap {
				padding: 12px;
				display: flex;
				flex-direction: column;
				justify-content: space-between;
				flex: 1;
				min-width: 0;
			}
			.item-title {
				font-size: 0.95rem;
				font-weight: 700;
				color: #0f172a;
				margin: 0 0 6px 0;
				line-height: 1.4;
			}
			:global(html.dark) .item-title {
				color: #f1f5f9;
			}

			.rating-pill {
				display: inline-block;
				font-size: 0.72rem;
				font-weight: 600;
				color: #eab308;
				background: rgba(234, 179, 8, 0.12);
				padding: 2px 7px;
				border-radius: 4px;
				margin-bottom: 6px;
				width: fit-content;
			}

			.item-comment {
				font-size: 0.78rem;
				color: #64748b;
				margin: 0;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
				line-height: 1.5;
			}
			:global(html.dark) .item-comment {
				color: #94a3b8;
			}

			.item-date {
				font-size: 0.72rem;
				color: #94a3b8;
				margin-top: 8px;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="page-header">
				<h1 class="page-title">🎬 豆瓣书影音</h1>
				<p class="page-desc">电影、阅读与生活随记</p>
				<div class="page-meta">
					数据来源：<a href={`https://www.douban.com/people/${DOUBAN_USER_ID}/`} target="_blank" rel="noopener noreferrer">我的豆瓣个人主页 ↗</a>
				</div>
			</div>

			<div class="douban-grid">
				{items.map((item) => (
					<a href={item.link} target="_blank" rel="noopener noreferrer" class="douban-card">
						<div class="cover-wrap">
							{item.imgSrc ? (
								<img 
									src={item.imgSrc} 
									alt={item.title} 
									class="douban-cover" 
									loading="lazy" 
									referrerpolicy="no-referrer"
								/>
							) : (
								<div style="height:100%;display:flex;align-items:center;justify-content:center;color:#64748b;font-size:0.75rem;">无封面</div>
							)}
						</div>
						<div class="info-wrap">
							<div>
								<h3 class="item-title">{item.title}</h3>
								{item.rating && <div class="rating-pill">推荐: {item.rating}</div>}
								{item.comment && <p class="item-comment">{item.comment}</p>}
							</div>
							<div class="item-date">标记于 {item.pubDate}</div>
						</div>
					</a>
				))}
			</div>
		</main>
		<Footer />
	</body>
</html>