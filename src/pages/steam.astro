---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const STEAM_ID = '76561198377154399';
const STEAM_NAME = '浪浪山小鱼';

// Steam 游戏配置
const recentSteamGames = [
	{
		appid: '582010',
		name: '怪物猎人：世界',
		hours: '320h',
		icon: 'https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/582010/capsule_231x87.jpg'
	},
	{
		appid: '570',
		name: 'Dota 2',
		hours: '1,520h',
		icon: 'https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/570/capsule_231x87.jpg'
	},
	{
		appid: '730',
		name: 'Counter-Strike 2',
		hours: '340h',
		icon: 'https://shared.fastly.steamstatic.com/store_item_assets/steam/apps/730/capsule_231x87.jpg'
	}
];

// 常玩联机游戏配置
const favoriteGames = [
	{
		name: '无畏契约 (VALORANT)',
		id: '浪浪山小鱼#1234',
		server: '腾讯国服 / 拳头港服',
		icon: '🎯'
	},
	{
		name: '怪物猎人：荒野 / 世界',
		id: '浪浪山小鱼',
		server: 'Steam 全球联机',
		icon: '🦖'
	},
	{
		name: '三角洲行动',
		id: '浪浪山小鱼',
		server: '安全区烽火地带',
		icon: '🔫'
	},
	{
		name: '英雄联盟 LOL',
		id: '浪浪山小鱼',
		server: '艾欧尼亚 / 峡谷之巅',
		icon: '⚔️'
	}
];
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`游戏人生 - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			body {
				background-color: #0b0f17;
				color: #e2e8f0;
			}
			main {
				max-width: 860px;
				margin: 2rem auto 4rem;
				padding: 0 1.25rem;
			}

			.glass-card {
				background: rgba(22, 27, 34, 0.7);
				backdrop-filter: blur(16px);
				-webkit-backdrop-filter: blur(16px);
				border: 1px solid rgba(255, 255, 255, 0.08);
				border-radius: 16px;
				padding: 1.75rem;
				box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.37);
				margin-bottom: 2.5rem;
			}

			.steam-header {
				display: flex;
				justify-content: space-between;
				align-items: center;
				margin-bottom: 1.8rem;
			}
			.user-info {
				display: flex;
				align-items: center;
				gap: 1rem;
			}
			.avatar-box {
				width: 58px;
				height: 58px;
				border-radius: 12px;
				overflow: hidden;
				border: 2px solid rgba(255, 255, 255, 0.15);
				background: #171a21;
				display: flex;
				align-items: center;
				justify-content: center;
				font-size: 1.8rem;
			}
			.user-meta .tag {
				font-size: 0.72rem;
				letter-spacing: 1px;
				color: #64748b;
				margin-bottom: 2px;
				font-weight: 600;
			}
			.user-meta .name {
				font-size: 1.35rem;
				font-weight: 700;
				color: #ffffff;
				margin: 0;
			}

			/* 状态小标签 */
			.status-pill {
				display: inline-flex;
				align-items: center;
				gap: 8px;
				background: rgba(255, 255, 255, 0.06);
				border: 1px solid rgba(255, 255, 255, 0.08);
				padding: 6px 14px;
				border-radius: 20px;
				font-size: 0.85rem;
				color: #94a3b8;
			}
			.status-dot {
				width: 8px;
				height: 8px;
				background: #64748b;
				border-radius: 50%;
				transition: all 0.3s ease;
			}
			.status-dot.online {
				background: #10b981;
				box-shadow: 0 0 8px #10b981;
			}
			.status-dot.gaming {
				background: #60a5fa;
				box-shadow: 0 0 8px #60a5fa;
			}
			.status-dot.offline {
				background: #64748b;
			}

			.recent-title {
				font-size: 0.85rem;
				color: #64748b;
				margin-bottom: 0.8rem;
				font-weight: 500;
			}
			.games-row {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
				gap: 12px;
			}
			.game-pill {
				background: rgba(255, 255, 255, 0.04);
				border: 1px solid rgba(255, 255, 255, 0.06);
				border-radius: 10px;
				padding: 8px 12px;
				display: flex;
				align-items: center;
				gap: 12px;
				text-decoration: none;
				color: inherit;
				transition: all 0.2s ease;
			}
			.game-pill:hover {
				background: rgba(255, 255, 255, 0.09);
				border-color: rgba(255, 255, 255, 0.15);
				transform: translateY(-2px);
			}
			.game-thumb {
				width: 52px;
				height: 28px;
				border-radius: 4px;
				object-fit: cover;
				background: #171a21;
			}
			.game-pill-info {
				flex: 1;
				min-width: 0;
			}
			.game-pill-name {
				font-size: 0.88rem;
				font-weight: 600;
				color: #f1f5f9;
				margin: 0;
				white-space: nowrap;
				overflow: hidden;
				text-overflow: ellipsis;
			}
			.game-pill-time {
				font-size: 0.75rem;
				color: #64748b;
				margin: 2px 0 0 0;
			}

			.section-header h2 {
				font-size: 1.5rem;
				font-weight: 800;
				color: #ffffff;
				margin: 0 0 4px 0;
			}
			.section-header p {
				color: #64748b;
				font-size: 0.9rem;
				margin: 0 0 1.25rem 0;
			}
			.fav-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
				gap: 12px;
			}
			.fav-card {
				background: rgba(22, 27, 34, 0.55);
				backdrop-filter: blur(12px);
				border: 1px solid rgba(255, 255, 255, 0.06);
				border-radius: 12px;
				padding: 14px 16px;
				display: flex;
				align-items: center;
				gap: 14px;
				transition: all 0.2s ease;
			}
			.fav-card:hover {
				border-color: rgba(255, 255, 255, 0.18);
				background: rgba(255, 255, 255, 0.05);
				transform: translateY(-2px);
			}
			.fav-icon {
				font-size: 1.8rem;
				width: 44px;
				height: 44px;
				background: rgba(255, 255, 255, 0.05);
				border-radius: 8px;
				display: flex;
				align-items: center;
				justify-content: center;
			}
			.fav-info h3 {
				font-size: 0.95rem;
				font-weight: 700;
				color: #ffffff;
				margin: 0 0 3px 0;
			}
			.fav-info p {
				font-size: 0.78rem;
				color: #94a3b8;
				margin: 0;
			}
			.fav-meta {
				display: flex;
				gap: 8px;
				margin-top: 4px;
				font-size: 0.75rem;
				color: #64748b;
			}

			.steam-actions {
				margin-top: 1.5rem;
				display: flex;
				justify-content: flex-end;
				gap: 10px;
			}
			.steam-link-btn {
				font-size: 0.85rem;
				color: #94a3b8;
				text-decoration: none;
				padding: 6px 14px;
				border-radius: 6px;
				background: rgba(255, 255, 255, 0.04);
				border: 1px solid rgba(255, 255, 255, 0.06);
				transition: all 0.2s;
			}
			.steam-link-btn:hover {
				color: #ffffff;
				background: rgba(255, 255, 255, 0.1);
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="glass-card">
				<div class="steam-header">
					<div class="user-info">
						<div class="avatar-box">
							<span>🐟</span>
						</div>
						<div class="user-meta">
							<div class="tag">STEAM 状态</div>
							<h1 class="name">{STEAM_NAME}</h1>
						</div>
					</div>
					<!-- 动态状态药丸 -->
					<div class="status-pill">
						<span id="live-dot" class="status-dot"></span>
						<span id="live-status">检测中...</span>
					</div>
				</div>

				<div class="recent-title">最近玩过</div>
				<div class="games-row">
					{recentSteamGames.map((game) => (
						<a 
							href={`https://store.steampowered.com/app/${game.appid}/`} 
							target="_blank" 
							rel="noopener noreferrer" 
							class="game-pill"
						>
							<img src={game.icon} alt={game.name} class="game-thumb" loading="lazy" />
							<div class="game-pill-info">
								<h4 class="game-pill-name">{game.name}</h4>
								<p class="game-pill-time">总游玩 {game.hours}</p>
							</div>
						</a>
					))}
				</div>

				<div class="steam-actions">
					<a href={`https://steamcommunity.com/profiles/${STEAM_ID}`} target="_blank" rel="noopener noreferrer" class="steam-link-btn">
						↗ 访问个人主页
					</a>
					<a href={`https://steamcommunity.com/profiles/${STEAM_ID}/inventory/`} target="_blank" rel="noopener noreferrer" class="steam-link-btn">
						📦 查看个人库存
					</a>
				</div>
			</div>

			<div class="section-header">
				<h2>我喜欢玩的游戏</h2>
				<p>欢迎来找我玩 / 组队开黑</p>
			</div>

			<div class="fav-grid">
				{favoriteGames.map((game) => (
					<div class="fav-card">
						<div class="fav-icon">{game.icon}</div>
						<div class="fav-info">
							<h3>{game.name}</h3>
							<p>ID: {game.id}</p>
							<div class="fav-meta">
								<span>🏷 {game.server}</span>
							</div>
						</div>
					</div>
				))}
			</div>
		</main>
		<Footer />

		<!-- 客户端轻量状态拉取脚本（无需自己搭服务器） -->
		<script define:vars={{ STEAM_ID }}>
			async function checkSteamStatus() {
				const dot = document.getElementById('live-dot');
				const text = document.getElementById('live-status');
				if (!dot || !text) return;

				try {
					// 访问公共轻量 CORS 代理接口获取状态
					const res = await fetch(`https://api.steampowered.com/ISteamUser/GetPlayerSummaries/v0002/?steamids=${STEAM_ID}`, {
						cache: 'no-store'
					}).catch(() => null);

					// 如果直连受跨域限制，使用公共免鉴权状态通道查询
					const proxyRes = await fetch(`https://steam-min-api.deno.dev/status?steamid=${STEAM_ID}`).catch(() => null);

					if (proxyRes && proxyRes.ok) {
						const data = await proxyRes.json();
						if (data.game) {
							dot.className = 'status-dot gaming';
							text.textContent = `游戏中: ${data.game}`;
							return;
						} else if (data.online) {
							dot.className = 'status-dot online';
							text.textContent = '在线';
							return;
						}
					}
					// 备用兜底判断：未处于游戏时标为离线
					dot.className = 'status-dot offline';
					text.textContent = '离线';
				} catch (e) {
					dot.className = 'status-dot offline';
					text.textContent = '离线';
				}
			}

			checkSteamStatus();
			document.addEventListener('astro:after-swap', checkSteamStatus);
		</script>
	</body>
</html>