---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

// 这里填入你的 SteamID64（17位数字，比如 76561198xxxxxxxxx）
const STEAM_ID = '76561198000000000'; 
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`Steam 状态与游戏展柜 - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
		<style>
			main {
				max-width: 820px;
				margin: 2rem auto;
				padding: 0 1rem;
			}
			.page-header {
				margin-bottom: 2rem;
				border-bottom: 1px solid var(--card-border);
				padding-bottom: 1.5rem;
			}
			.page-header h1 {
				margin: 0 0 0.5rem 0;
				font-size: 2rem;
				color: var(--heading-color);
			}
			.page-header p {
				margin: 0;
				color: var(--text-color);
				font-size: 1rem;
			}
			.steam-section {
				display: flex;
				flex-direction: column;
				gap: 1.5rem;
			}
			.card-box {
				background: var(--card-bg);
				border: 1px solid var(--card-border);
				border-radius: 12px;
				padding: 1.5rem;
			}
			.card-box h2 {
				margin-top: 0;
				margin-bottom: 1rem;
				font-size: 1.3rem;
				color: var(--heading-color);
			}
			.card-box p {
				color: var(--text-color);
				margin-bottom: 1rem;
			}
			.steam-badge-container {
				display: flex;
				justify-content: center;
				padding: 1rem 0;
			}
			.steam-badge-container img {
				max-width: 100%;
				height: auto;
				border-radius: 8px;
			}
			.profile-btn {
				display: inline-block;
				padding: 8px 16px;
				background: var(--accent);
				color: #fff;
				text-decoration: none;
				border-radius: 6px;
				font-weight: 500;
				margin-top: 0.5rem;
				transition: opacity 0.2s;
			}
			.profile-btn:hover {
				opacity: 0.9;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="page-header">
				<h1>🎮 Steam 游戏人生</h1>
				<p>记录游戏时光、实时在线状态与库存展示</p>
			</section>

			<div class="steam-section">
				<!-- 在线状态卡片 -->
				<section class="card-box">
					<h2>🕹️ 当前实时状态</h2>
					<div class="steam-badge-container">
						<!-- 利用社区动态 SVG 卡片实时展示状态（需替换你的 SteamID） -->
						<img 
							src={`https://steam-chroma.vercel.app/api?steamid=${STEAM_ID}`} 
							alt="Steam 状态卡片" 
							loading="lazy"
						/>
					</div>
					<div style="text-align: center;">
						<a 
							href={`https://steamcommunity.com/profiles/${STEAM_ID}`} 
							target="_blank" 
							rel="noopener noreferrer"
							class="profile-btn"
						>
							访问我的 Steam 个人主页
						</a>
					</div>
				</section>
			</div>
		</main>
		<Footer />
	</body>
</html>